# ===== Servidor =====
PORT=3000
NODE_ENV=production
# URL pública usada em links de recuperação de senha
APP_URL=http://localhost:3000

# ===== Produto (SaaS) =====
# Nome exibido na tela de login e no cadastro de novas empresas
APP_NAME=CRM
# Permite que novas empresas criem conta pela tela de login (true/false)
ALLOW_SIGNUP=true
# Dias de teste grátis para novas empresas
TRIAL_DAYS=14

# ===== Banco de dados (PostgreSQL) =====
DATABASE_URL=postgres://crm:senha-forte@localhost:5432/crm
# Defina como "true" quando o banco exigir SSL (ex.: provedores gerenciados)
DATABASE_SSL=false

# ===== Sessões =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-este-valor
# Duração da sessão em horas
SESSION_HOURS=12
# Defina "true" quando servido via HTTPS (cookie Secure)
COOKIE_SECURE=false

# ===== E-mail (opcional; usado na recuperação de senha) =====
# Sem SMTP, o link de recuperação é registrado no log do servidor e o
# administrador pode gerar o link manualmente em Configurações > Usuários.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CRM <nao-responda@empresa.com.br>"

# ===== Segredos de integrações =====
# Chave para criptografar os tokens de WhatsApp de cada empresa (padrão: SESSION_SECRET).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Atenção: trocar esta chave exige reconectar os canais de WhatsApp das empresas.
ENCRYPTION_KEY=

# ===== Cobrança das empresas (Asaas) — opcional =====
# Sem ASAAS_API_KEY, as empresas escolhem o plano e você ativa à mão em /plataforma.
# Chave em: Asaas > Integrações > Chave de API. Use ASAAS_ENV=sandbox para testar.
ASAAS_API_KEY=
ASAAS_ENV=production
# Token que o Asaas envia no webhook (Asaas > Integrações > Webhooks, URL: https://SEU_DOMINIO/api/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=
# Dias de tolerância após o vencimento antes de bloquear o acesso
BILLING_GRACE_DAYS=5
