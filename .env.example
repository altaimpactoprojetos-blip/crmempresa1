# ===== Servidor =====
PORT=3000
NODE_ENV=production
# URL pública usada em links de recuperação de senha
APP_URL=http://localhost:3000

# ===== Banco de dados (PostgreSQL) =====
DATABASE_URL=postgres://crm:senha-forte@localhost:5432/crm
# Defina como "true" quando o banco exigir SSL (ex.: provedores gerenciados)
DATABASE_SSL=false

# ===== Sessões =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-este-valor
# Duração da sessão em horas
SESSION_HOURS=12
# Defina "true" quando servido via HTTPS (cookie Secure)
COOKIE_SECURE=false

# ===== E-mail (opcional; usado na recuperação de senha) =====
# Sem SMTP, o link de recuperação é registrado no log do servidor e o
# administrador pode gerar o link manualmente em Configurações > Usuários.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CRM <nao-responda@empresa.com.br>"

# ===== WhatsApp Business API oficial (opcional) =====
# Deixe em branco para manter a integração como "desconectada".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ===== n8n (automações) =====
# Entrada (n8n → CRM): chave que o n8n envia no cabeçalho X-API-Key.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_API_KEY=
# Saída (CRM → n8n): URL do nó Webhook que recebe os eventos do CRM.
N8N_WEBHOOK_URL=
# Opcional: assina o corpo enviado ao n8n (cabeçalho X-CRM-Signature: sha256=...).
N8N_WEBHOOK_SECRET=
# Tempo máximo de espera pela resposta do n8n, em milissegundos.
N8N_TIMEOUT_MS=10000
# Espera da busca de fornecedores (aba Fornecedores), em milissegundos.
N8N_SEARCH_TIMEOUT_MS=60000
